[Unit]
Description=AI Controller Python Service
After=network.target redis-server.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/ai-os/app-controller
Environment=PATH=/root/ai-os/app-controller/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/root/ai-os/app-controller/.venv/bin/python main.py
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aiclient-python

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Security settings
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/ai-os/app-controller
ReadWritePaths=/root/ai-os/app-controller/logs

[Install]
WantedBy=multi-user.target
