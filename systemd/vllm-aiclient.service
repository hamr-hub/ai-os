[Unit]
Description=vLLM Inference Server (AIClient) - Unified Service
After=network.target nvidia-persistenced.service
Wants=nvidia-persistenced.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/ai-os/app-controller/scripts

Environment="VLLM_MODEL_PATH=/mnt/pve_models/Gemma-4-31B-Abliterated"
Environment="CUDA_VISIBLE_DEVICES=0"
Environment="VLLM_ENV_PATH=/root/ai-suite/vllm_env"
Environment="VLLM_LOG_DIR=/root/ai-os/logs/vllm-aiclient"
Environment="VLLM_PORT=8000"

ExecStart=/root/ai-os/app-controller/scripts/start_vllm_aiclient.sh

KillMode=mixed
TimeoutStartSec=900
TimeoutStopSec=300
Restart=always
RestartSec=10

LimitMEMLOCK=infinity
LimitSTACK=infinity
LimitNOFILE=65536

StandardOutput=journal
StandardError=journal
SyslogIdentifier=vllm-aiclient

[Install]
WantedBy=multi-user.target
