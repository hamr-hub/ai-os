#!/Users/hyx/miniforge3/bin/python3
import sys
import os
import time
import subprocess
import signal

# Add current dir to path to import StateManager
sys.path.append(os.path.dirname(__file__))
from state_manager import StateManager, PID_DIR

if not os.path.exists(PID_DIR):
    os.makedirs(PID_DIR)

SERVICE_PORTS = {
    "vllm": 8000,
    "vllm-gemma": 8000,
    "vllm-llama": 8001,
    "vllm-aiclient": 8000
}

def get_pid(service_name):
    pid_file = os.path.join(PID_DIR, f"{service_name}.pid")
    if os.path.exists(pid_file):
        with open(pid_file, "r") as f:
            try:
                return int(f.read().strip())
            except:
                return None
    return None

def save_pid(service_name, pid):
    pid_file = os.path.join(PID_DIR, f"{service_name}.pid")
    with open(pid_file, "w") as f:
        f.write(str(pid))

def clear_pid(service_name):
    pid_file = os.path.join(PID_DIR, f"{service_name}.pid")
    if os.path.exists(pid_file):
        os.remove(pid_file)

def is_pid_running(pid):
    if pid is None:
        return False
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False

def handle_start(service_name):
    pid = get_pid(service_name)
    if is_pid_running(pid):
        return 0
    
    port = SERVICE_PORTS.get(service_name, 8000)
    mock_script = os.path.join(os.path.dirname(__file__), "vllm_mock.py")
    python_exe = sys.executable
    cmd = [python_exe, mock_script, "--port", str(port)]
    
    log_file = open(os.path.join(PID_DIR, f"{service_name}.log"), "a")
    proc = subprocess.Popen(cmd, stdout=log_file, stderr=log_file, preexec_fn=os.setpgrp)
    
    save_pid(service_name, proc.pid)
    
    state = StateManager.get_state()
    state["vllm"]["status"] = "loading"
    state["vllm"]["loading_start"] = time.time()
    state["vllm"]["current_model"] = service_name
    StateManager.save_state(state)
    
    return 0

def handle_stop(service_name):
    pid = get_pid(service_name)
    if is_pid_running(pid):
        try:
            os.killpg(os.getpgid(pid), signal.SIGTERM)
            for _ in range(50):
                if not is_pid_running(pid):
                    break
                time.sleep(0.1)
            if is_pid_running(pid):
                os.killpg(os.getpgid(pid), signal.SIGKILL)
        except:
            pass
    
    clear_pid(service_name)
    
    state = StateManager.get_state()
    if state["vllm"].get("current_model") == service_name:
        state["vllm"]["status"] = "stopped"
        StateManager.save_state(state)
    return 0

def handle_status(service_name):
    pid = get_pid(service_name)
    if not is_pid_running(pid):
        print("inactive")
        return 3
        
    StateManager.update_vllm_status()
    state = StateManager.get_state()
    status = state.get("vllm", {}).get("status", "stopped")
    
    if status in ["active", "loading"]:
        print("active")
        return 0
    else:
        print("inactive")
        return 3

def handle_show(service_name):
    pid = get_pid(service_name)
    running = is_pid_running(pid)
    StateManager.update_vllm_status()
    state = StateManager.get_state()
    
    if running:
        status = state["vllm"]["status"]
        if status == "active":
            print("ActiveState=active")
            print("SubState=running")
            print(f"MainPID={pid}")
            print("MemoryCurrent=22000000000")
        elif status == "loading":
            print("ActiveState=active")
            print("SubState=activating")
            print(f"MainPID={pid}")
            print("MemoryCurrent=12000000000")
        elif status == "error":
            print("ActiveState=failed")
            print("SubState=failed")
            print(f"MainPID={pid}")
        else:
            print("ActiveState=active")
            print("SubState=running")
            print(f"MainPID={pid}")
    else:
        print("ActiveState=inactive")
        print("SubState=dead")
        print("MainPID=0")
        print("MemoryCurrent=0")
    return 0

args = sys.argv[1:]
if not args:
    sys.exit(1)

cmd = args[0]
service_name = args[1] if len(args) > 1 else "vllm-aiclient"

if cmd == "start":
    sys.exit(handle_start(service_name))
elif cmd == "stop":
    sys.exit(handle_stop(service_name))
elif cmd == "restart":
    handle_stop(service_name)
    sys.exit(handle_start(service_name))
elif cmd == "is-active":
    sys.exit(handle_status(service_name))
elif cmd == "show":
    sys.exit(handle_show(service_name))
else:
    sys.exit(0)
