[Unit]
Description=Nginx HTTP Server for AI Controller (Port 30000)
After=network.target

[Service]
Type=forking
PIDFile=/var/run/nginx_30000.pid
ExecStartPre=/usr/sbin/nginx -t -c /etc/nginx/nginx_30000.conf
ExecStart=/usr/sbin/nginx -c /etc/nginx/nginx_30000.conf
ExecReload=/usr/sbin/nginx -s reload -c /etc/nginx/nginx_30000.conf
ExecStop=/usr/sbin/nginx -s stop -c /etc/nginx/nginx_30000.conf
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
