# AI OS Platform Environment Variables

# Server Configuration
HOST=0.0.0.0
PORT=5000
CLIENT_PORT=3000

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_DB=0

# Logging Configuration
LOG_LEVEL=INFO
LOG_DIR=./logs

# Security
SECRET_KEY=your-secret-key-here
ALLOWED_ORIGINS=*

# Timeouts
REQUEST_TIMEOUT=120
MODEL_START_TIMEOUT=120

# Feature Flags
ENABLE_REDIS=true
ENABLE_WEBSOCKET=true
ENABLE_PROMETHEUS=true

# vLLM Configuration
VLLM_SERVICE_NAME=vllm
VLLM_DEFAULT_PORT=8000
MODEL_BASE_PATH=/mnt/pve_models